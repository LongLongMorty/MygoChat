### Go template
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

.idea
.idea/*
.opencode
.opencode/*

*.xml

*_local.go
*_local.toml

vendor/*

*.log

static/avatars/*

static/files/*

web/chat-server/src/assets/cert/*

internal/service/kafka/start.bat

*.sh

*.ext

# Go build cache
.cache/

# Built binaries
kama_chat_server.exe
performance.exe

# Runtime logs
err*.log
out*.log
server_*.log
local-server.*.log
performance-server.*.log
your*

# Test data
# Keep results.md and README.md but ignore individual JSON result files
test/performance/results/*.json
test/performance/users.json
test/performance/users_20*.json

# Config with real credentials (SMTP auth code / DB passwords) — keep a template instead
configs/config.toml

# Temp files
test_*.json
genhash.go

# OS files
*.tex
Desktop.ini
Thumbs.db
.DS_Store
docs/项目问答记录.md
方案.md
# Test runtime logs
test/**/logs/
test/**/your log path
